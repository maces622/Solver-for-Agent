{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "event.state_changed",
  "type": "object",
  "additionalProperties": false,
  "required": ["jsonrpc", "method", "params"],
  "properties": {
    "jsonrpc": { "const": "2.0" },
    "method": { "const": "event.state_changed" },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "revision", "changedPaths"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "revision": { "type": "integer", "minimum": 0 },
        "changedPaths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    }
  }
}