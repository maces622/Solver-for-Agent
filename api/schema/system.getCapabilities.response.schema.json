{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "system.getCapabilities response",
  "type": "object",
  "additionalProperties": false,
  "required": ["jsonrpc", "id", "result"],
  "properties": {
    "jsonrpc": { "const": "2.0" },
    "id": { "type": ["string", "integer", "null"] },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "capabilities", "methods", "limits"],
      "properties": {
        "protocol": { "const": "gto-api/1.0" },
        "capabilities": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "methods": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "capability", "async"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "capability": { "type": ["string", "null"] },
              "async": { "type": "boolean" }
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxMessageBytes"],
          "properties": {
            "maxMessageBytes": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  }
}