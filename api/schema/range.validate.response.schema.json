{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "range.validate response",
  "type": "object",
  "additionalProperties": false,
  "required": ["jsonrpc", "id", "result"],
  "properties": {
    "jsonrpc": { "const": "2.0" },
    "id": { "type": ["string", "integer", "null"] },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "normalizedRange", "comboCount", "warnings", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "normalizedRange": { "type": ["string", "null"] },
        "comboCount": { "type": "integer", "minimum": 0 },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "code", "message"],
            "properties": {
              "path": { "type": "string" },
              "code": { "type": "string", "minLength": 1 },
              "message": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}